# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env

# GitHub token. Strongly recommended: lifts the API rate limit from 60 to
# 5,000 requests/hour. A classic PAT with `public_repo` scope is enough —
# this tool reads public data only.
# If you already ran `gh auth login`, you can leave this blank; the tool
# falls back to the gh CLI token automatically.
GITHUB_TOKEN=

# OpenAI API key. Optional. Enables the buyer-classification pass, which
# separates commercial entities from foundations, community projects, and
# public agencies. Without it the census still runs and the report still
# renders — organizations are simply left unclassified.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Model used for classification. Optional — defaults to gpt-5.
# Model availability differs per account; if the default is rejected, the run
# prints the models your key can actually reach, so you can set one here.
# Must be a model that supports structured outputs.
OPENAI_MODEL=
